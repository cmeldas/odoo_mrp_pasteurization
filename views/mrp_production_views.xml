<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mrp_production_form_view_inherited" model="ir.ui.view">
            <field name="name">mrp.production.form.pasteurisation</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view" />
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="Pasterace" name="pasteurisation_data">
                        <group>
                            <group>
                                <field name="pasteurisation_temperature"
                                    readonly="state in ('done', 'cancel')" />
                                <field name="pasteurisation_duration"
                                    readonly="state in ('done', 'cancel')" />
                                <field name="pasteurisation_start"
                                    readonly="state in ('done', 'cancel')" />
                                <button name="set_pasteurisation_start" string="Začátek pasterizace"
                                    type="object"
                                    class="btn-success"
                                    invisible="state in ('done', 'cancel')" />
                                <button name="end_pasteurisation" string="Ukončit pasterizaci"
                                    type="object"
                                    class="btn-warning"
                                    invisible="state in ('done', 'cancel')" />
                            </group>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>
